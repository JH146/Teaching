        count += 1
print("9. Vowel count:", count)

# 10. Check if a number is prime
n = 29
is_prime = True
if n < 2:
    is_prime = False
else:
    for i in range(2, int(n**0.5) + 1):
        if n % i == 0:
            is_prime = False
            break
print("10. Is prime?", is_prime)
